{
  "tool_id": "prompt.workbook",
  "name": "Tao prompt tung canh",
  "version": "0.1.0",
  "contract_version": "1",
  "description": "Tach phu de thanh scene manifest va workbook trao doi.",
  "inputs": [
    {"name": "subtitles", "kind": "subtitle", "schema": "srt.v1"},
    {"name": "context", "kind": "json", "schema": "content-package.v1", "required": false}
  ],
  "outputs": [
    {"name": "scenes", "kind": "json", "schema": "scene-manifest.v1"},
    {"name": "workbook", "kind": "table", "schema": "scene-workbook.v1"}
  ],
  "config_schema": {"type":"object","additionalProperties":false,"properties":{
    "model":{"type":"string","enum":["claude-sonnet-5","claude-opus-5"],"default":"claude-sonnet-5"},
    "engine":{"type":"string","enum":["veo3","seedance"],"default":"veo3"},
    "nhat_quan_nhan_vat":{"type":"boolean","default":true},
    "che_do_ke":{"type":"string","enum":["mot_nhan_vat","nhan_vat_va_boi_canh","tu_xay"],"default":"tu_xay"},
    "thumbnail":{"type":"boolean","default":true},
    "nhac":{"type":"boolean","default":true}
  }},
  "runtime": {"kind": "python", "entrypoint": "run.py", "timeout_seconds": 5400,
              "python_modules": ["openpyxl"]},
  "permissions": ["network.shopapi", "workspace.read", "workspace.write", "secret.shopapi"]
}
