{
  "tool_id": "voice.shopapi",
  "name": "Tao giong doc ShopAPI",
  "version": "0.1.0",
  "contract_version": "1",
  "description": "Tao va ghep audio tu kich ban qua ShopAPI.",
  "inputs": [
    {"name": "script", "kind": "text", "schema": "voice-script.v1"}
  ],
  "outputs": [
    {"name": "audio", "kind": "audio", "schema": "narration-audio.v1"}
  ],
  "config_schema": {"type":"object","additionalProperties":false,"properties":{
    "voice_id":{"type":"string","default":"vi_female_01"},
    "format":{"type":"string","enum":["mp3","wav"],"default":"mp3"},
    "language_code":{"type":"string","pattern":"^[a-z]{2}$","description":"Ma ngon ngu ISO 639-1 (vi, en, ja...). Ghi kem tieng cua bai; may chu hien chua dung den (do 08/09/2026), model tu nhan dien tu van ban."}
  }},
  "runtime": {"kind": "python", "entrypoint": "run.py", "timeout_seconds": 3600},
  "permissions": ["network.shopapi", "workspace.write", "secret.shopapi"]
}
